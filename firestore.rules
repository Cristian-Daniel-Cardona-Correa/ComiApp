rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones de validación
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Regla de privacidad estricta (Ley 1581 Habeas Data):
    // Se prohíbe explícitamente guardar datos biométricos, audio o video
    function doesNotContainMediaBytes(data) {
      return !('audioBytes' in data) &&
             !('videoBytes' in data) &&
             !('cameraStream' in data);
    }

    // Catálogo de recetas: lectura pública, escritura solo administradores
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.admin == true;
    }

    // Perfiles de usuario: cada usuario solo lee y escribe su propio documento
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && doesNotContainMediaBytes(request.resource.data);
      allow delete: if isOwner(userId);

      // Sesiones de progreso de cocina y temporizadores del usuario
      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
